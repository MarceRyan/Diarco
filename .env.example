# Copia este archivo como .env.local en apps/web y apps/mobile y completa los valores.
# Con Supabase local, `pnpm db:start` muestra la URL y la publishable key.
# Nunca pongas aquí la secret / service_role key: estas variables llegan al navegador y al celular.

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# --- Móvil (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
